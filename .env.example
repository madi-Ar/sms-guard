# Скопируйте этот файл в .env через: python scripts/init_env.py
# Этот файл не должен содержать реальные секреты.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Almaty
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_NAME=db.sqlite3

# Зарезервировано для PostgreSQL при демонстрации (задание 16)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
